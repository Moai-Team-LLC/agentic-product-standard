{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Moai-Team-LLC/agentic-product-standard/canon/schema/antipatterns.schema.json",
  "title": "Anti-patterns (canon/antipatterns.yaml)",
  "type": "object",
  "required": ["antipatterns"],
  "additionalProperties": false,
  "properties": {
    "antipatterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "title", "since", "summary", "signal", "failure_mode", "fix", "severity"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "maxLength": 80 },
          "gloss": { "type": "string" },
          "since": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "changed": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "summary": { "type": "string" },
          "signal": { "type": "string" },
          "failure_mode": { "type": "string" },
          "fix": { "type": "string" },
          "severity": { "type": "string", "pattern": "^(Critical|High|Medium-High|Medium|Low)\\b" }
        }
      }
    }
  }
}
